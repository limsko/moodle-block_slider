{{!
    @template block_slider/control

    Przycisk sterowania slajderem (poprzedni, następny, pauza/odtwarzanie).

    Context variables required for this template:
    * action - prev, next albo playpause
    * label - etykieta dla czytników ekranu
    * classes - dodatkowe klasy
    * isprev, isnext, ispause - rodzaj ikony

    Example context (json):
    {
        "action": "next",
        "label": "Next slide",
        "classes": "block-slider-arrow block-slider-next",
        "isprev": false,
        "isnext": true,
        "ispause": false
    }
}}
<button type="button" class="block-slider-control {{classes}}" data-action="{{action}}" aria-label="{{label}}">
    {{#isprev}}<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M15 5l-7 7 7 7"/></svg>{{/isprev}}
    {{#isnext}}<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M9 5l7 7-7 7"/></svg>{{/isnext}}
    {{#ispause}}
    <svg class="block-slider-icon-pause" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="6" y="5" width="4" height="14" rx="1"/><rect x="14" y="5" width="4" height="14" rx="1"/></svg>
    <svg class="block-slider-icon-play" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M8 5.5v13a1 1 0 0 0 1.5.86l10.5-6.5a1 1 0 0 0 0-1.72L9.5 4.64A1 1 0 0 0 8 5.5z"/></svg>
    {{/ispause}}
</button>
