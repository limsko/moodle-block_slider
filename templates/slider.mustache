{{!
    @template block_slider/slider

    Karuzela slajdów (wzorzec WAI-ARIA Carousel).

    Context variables required for this template:
    * uniqueid - identyfikator elementu
    * regionlabel - etykieta regionu
    * classes - klasy wynikające z ustawień
    * style - zmienne CSS
    * config - konfiguracja modułu JS (JSON)
    * slides - lista slajdów
    * overlaycontrols - sterowanie na grafice zamiast paska pod nią
    * prevbutton, nextbutton, pausebutton - przyciski (block_slider/control)
    * dots, controlbar - paginacja i pasek sterowania

    Example context (json):
    {
        "uniqueid": "block-slider-abc",
        "regionlabel": "Slider",
        "classes": "block-slider--slide block-slider--fit-cover block-slider--controls-bottom",
        "style": "--block-slider-per-view: 1;",
        "config": "{}",
        "overlaycontrols": false,
        "prevbutton": {"action": "prev", "label": "Previous slide", "classes": "block-slider-arrow", "isprev": true},
        "nextbutton": {"action": "next", "label": "Next slide", "classes": "block-slider-arrow", "isnext": true},
        "pausebutton": {"action": "playpause", "label": "Pause slideshow", "classes": "block-slider-playpause", "ispause": true},
        "dots": true,
        "controlbar": true,
        "slides": [
            {
                "index": 1,
                "first": true,
                "label": "1 of 2",
                "imageurl": "https://picsum.photos/1600/900",
                "mobileurl": "",
                "alt": "",
                "link": "https://moodle.org",
                "wraplink": true,
                "newwindow": false,
                "hascaption": true,
                "title": "Welcome",
                "subtitle": "Subtitle",
                "description": "",
                "showbutton": false,
                "buttontext": ""
            },
            {
                "index": 2,
                "first": false,
                "label": "2 of 2",
                "imageurl": "https://picsum.photos/1600/901",
                "alt": "Second slide",
                "hascaption": false
            }
        ]
    }
}}
<div id="{{uniqueid}}" class="block-slider {{classes}}" style="{{style}}" data-config="{{config}}">
    <section class="block-slider-region" aria-roledescription="{{#str}} carousel, block_slider {{/str}}" aria-label="{{regionlabel}}">
        <div class="block-slider-viewport">
            <div class="block-slider-track" aria-live="off">
                {{#slides}}
                <div class="block-slider-slide{{#first}} is-active{{/first}}" role="group" aria-roledescription="{{#str}} slide, block_slider {{/str}}" aria-label="{{label}}">
                    {{#wraplink}}<a class="block-slider-link" href="{{link}}"{{#linklabel}} aria-label="{{linklabel}}"{{/linklabel}}{{#newwindow}} target="_blank" rel="noopener"{{/newwindow}}>{{/wraplink}}
                    <div class="block-slider-body">
                        <div class="block-slider-media">
                            <picture>
                                {{#mobileurl}}<source media="(max-width: 767.98px)" srcset="{{mobileurl}}">{{/mobileurl}}
                                <img class="block-slider-image" src="{{imageurl}}" alt="{{alt}}" draggable="false" decoding="async" {{#first}}fetchpriority="high"{{/first}}{{^first}}loading="lazy"{{/first}}>
                            </picture>
                            <span class="block-slider-placeholder" aria-hidden="true">
                                <svg viewBox="0 0 24 24" focusable="false"><rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="9" cy="10" r="2"/><path d="M21 16l-5-5-9 9"/></svg>
                            </span>
                        </div>
                        {{#hascaption}}
                        <div class="block-slider-caption">
                            <div class="block-slider-caption-inner">
                                {{#title}}<p class="block-slider-caption-title">{{{title}}}</p>{{/title}}
                                {{#subtitle}}<p class="block-slider-caption-subtitle">{{{subtitle}}}</p>{{/subtitle}}
                                {{#description}}<p class="block-slider-caption-text">{{{description}}}</p>{{/description}}
                                {{#showbutton}}<a class="btn btn-primary block-slider-button" href="{{link}}"{{#newwindow}} target="_blank" rel="noopener"{{/newwindow}}>{{{buttontext}}}</a>{{/showbutton}}
                            </div>
                        </div>
                        {{/hascaption}}
                    </div>
                    {{#wraplink}}</a>{{/wraplink}}
                </div>
                {{/slides}}
            </div>
            {{#overlaycontrols}}
            {{#pausebutton}}{{> block_slider/control}}{{/pausebutton}}
            {{#prevbutton}}{{> block_slider/control}}{{/prevbutton}}
            {{#nextbutton}}{{> block_slider/control}}{{/nextbutton}}
            {{/overlaycontrols}}
        </div>
        {{#controlbar}}
        <div class="block-slider-controls">
            {{^overlaycontrols}}
            {{#pausebutton}}{{> block_slider/control}}{{/pausebutton}}
            {{#prevbutton}}{{> block_slider/control}}{{/prevbutton}}
            {{/overlaycontrols}}
            {{#dots}}<div class="block-slider-dots" role="group" aria-label="{{#str}} choosepage, block_slider {{/str}}"></div>{{/dots}}
            {{^overlaycontrols}}
            {{#nextbutton}}{{> block_slider/control}}{{/nextbutton}}
            {{/overlaycontrols}}
        </div>
        {{/controlbar}}
    </section>
</div>
